{
  "name": "POPin-Pricing",
  "version": "0.0.1",
  "description": "Universal Pricing for all",
  "main": "index.htm",
  "repository": "git@github.com:POPInNow/POPin-Pricing.git",
  "author": "POPin Product Team",
  "scripts": {
    "build": "webpack --progress --hide-modules --plugin clean-webpack-plugin --config webpack.config.js",
    "start": "webpack --watch --config webpack.config.js",
    "clean": "webpack --progress --hide-modules --plugin clean-webpack-plugin --config webpack.config.js",
    "version:patch": "yarn version -patch -m \"theme version patch bump\" && git push --follow-tags",
    "version:minor": "yarn version -minor -m \"theme version minor bump\" && git push --follow-tags",
    "version:major": "yarn version -major -m \"theme version major bump\" && git push --follow-tags"
  },
  "devDependencies": {
    "autoprefixer": "^7.1.6",
    "babel-core": "^6.26.3",
    "babel-loader": "^7.1.2",
    "babel-plugin-transform-object-rest-spread": "~6.26.0",
    "babel-preset-env": "^1.7.0",
    "clean-webpack-plugin": "^0.1.19",
    "copy-webpack-plugin": "^4.5.1",
    "css-loader": "^0.28.7",
    "extract-text-webpack-plugin": "^3.0.2",
    "postcss-loader": "^2.0.8",
    "sass-loader": "^6.0.6",
    "style-loader": "^0.19.0",
    "uglifyjs-webpack-plugin": "^1.2.5",
    "webpack": "^3.8.1"
  },
  "dependencies": {
    "bulma": "^0.7.1",
    "bulma-pricingtable": "latest",
    "node-sass": "^4.11.0"
  }
}
